# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de configuración. Copiar a .env.local y rellenar.
#   cp .env.example .env.local
#
# .env.local está en .gitignore (línea 34). NUNCA subirlo al repositorio:
# contiene la contraseña de administrador de producción.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (obligatorio) ────────────────────────────────────────────────────
# La URL del proyecto. Está en Dashboard > Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave "anon" / "publishable". Es PÚBLICA por diseño: viaja dentro del bundle
# del navegador y no protege nada por sí sola. La protection real la ponen las
# políticas RLS de la base de datos (ver supabase/migrations/).
# Si no la tienes: Dashboard > Settings > API > "Publishable key".
# También se puede copiar del bundle ya desplegado:
#   curl -s https://TU-SITIO/login | grep -o '/_next/static/[^"]*\.js' | ...
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_TU_CLAVE

# ── Scripts de administración (opcional) ─────────────────────────────────────
# Consumidos por ~35 scripts de scripts/ a través de scripts/_auth.mjs.
# ADMIN_PASSWORD es la contraseña del administrador de PRODUCCIÓN: trátala como
# una credencial real y no como una de desarrollo.
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=cambia-esto-por-una-clave-fuerte

# ── OpenAI (opcional) ────────────────────────────────────────────────────────
# Solo la usan los servicios de análisis con IA (src/services/ia.ts).
# Sin ella el sistema funciona igual; solo se desactivan esas funciones.
OPENAI_API_KEY=sk-...

# ── Para los tests E2E (opcional) ────────────────────────────────────────────
# e2e/_credentials.ts las lee y LANZA si faltan, en vez de recurrir a un login
# fijo. Ver e2e/_credentials.ts.
# E2E_EMAIL=admin@tu-dominio.com
# E2E_PASSWORD=...

# ── Aplicar migraciones (opcional) ───────────────────────────────────────────
# El token de acceso personal de Supabase, para `supabase db push`.
# Se obtiene en Dashboard > Settings > API > Access Tokens.
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_PROJECT_REF=TU-REF